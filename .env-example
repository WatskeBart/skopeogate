# Verplicht: skopeo-bestemmingsadres
SKOPEO_DESTINATION=docker://mijn.registry.com:5000/subpad1/subpad2/langersubpad/myrepo

# Optioneel: authenticatie bij de bestemming
SKOPEO_USERNAME=gebruiker
SKOPEO_PASSWORD_FILE=/run/secrets/skopeo-password

# Optioneel: maximale uploadgrootte in MB (standaard 400)
MAX_MB=400
